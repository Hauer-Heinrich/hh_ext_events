<T3DataStructure>
    <meta>
         <langDisable>1</langDisable>
    </meta>
    <sheets>
        <main>
            <ROOT>
               <TCEforms>
                   <sheetTitle>Einstellungen</sheetTitle>
               </TCEforms>
               <type>array</type>
               <el>
                    <settings.detailPage>
                        <exclude>1</exclude>
                        <label>Detail page</label>
                        <description></description>
                        <config>
                            <type>link</type>
                            <allowedTypes>
                                <numIndex index="0">page</numIndex>
                                <numIndex index="1">url</numIndex>
                            </allowedTypes>
                        </config>
                    </settings.detailPage>

                    <settings.listPage>
                        <exclude>1</exclude>
                        <label>List page</label>
                        <description></description>
                        <config>
                            <type>link</type>
                            <allowedTypes>
                                <numIndex index="0">page</numIndex>
                                <numIndex index="1">url</numIndex>
                            </allowedTypes>
                        </config>
                    </settings.listPage>

                    <settings.selectedItems>
                        <exclude>1</exclude>
                        <label>Show selected Items</label>
                        <description></description>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_hhextevents_domain_model_event</allowed>
                            <size>5</size>
                            <minitems>0</minitems>
                            <autoSizeMax>10</autoSizeMax>
                            <wizards>
                                <suggest>
                                    <type>suggest</type>
                                </suggest>
                            </wizards>
                            <suggestOptions>
                                <default>
                                    <addWhere>AND tx_hhextevents_domain_model_event.sys_language_uid IN (-1,0)</addWhere>
                                </default>
                            </suggestOptions>
                        </config>
                    </settings.selectedItems>

                    <settings.categories>
                        <exclude>1</exclude>
                        <label>Categories</label>
                        <config>
                            <type>select</type>
                            <renderMode>tree</renderMode>
                            <renderType>selectTree</renderType>
                            <treeConfig>
                                <parentField>parent</parentField>
                                <appearance>
                                    <maxLevels>99</maxLevels>
                                    <expandAll>TRUE</expandAll>
                                    <showHeader>TRUE</showHeader>
                                </appearance>
                            </treeConfig>
                            <foreign_table>sys_category</foreign_table>
                            <foreign_table_where>AND (sys_category.sys_language_uid = 0 OR sys_category.l10n_parent = 0) ORDER BY sys_category.sorting</foreign_table_where>
                            <size>15</size>
                            <minitems>0</minitems>
                            <maxitems>99</maxitems>
                        </config>
                    </settings.categories>

                    <settings.categoriesMatchType>
                        <exclude>1</exclude>
                        <label>Categories match type</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0" type="array">
                                    <numIndex index="0">OR (mindestens eine Kategorie)</numIndex>
                                    <numIndex index="1">OR</numIndex>
                                </numIndex>
                                <numIndex index="1" type="array">
                                    <numIndex index="0">AND (muss alle Kategorien haben)</numIndex>
                                    <numIndex index="1">AND</numIndex>
                                </numIndex>
                            </items>
                        </config>
                    </settings.categoriesMatchType>

                    <settings.startingpoint>
                        <exclude>1</exclude>
                        <label>LLL:EXT:core/Resources/Private/Language/locallang_general.xlf:LGL.startingpoint</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>3</size>
                            <maxitems>50</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.startingpoint>
                </el>
            </ROOT>
        </main>

        <layout>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Layout</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.field.eventLayout>
                        <exclude>1</exclude>
                        <label>Event layout</label>
                        <description></description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0" type="array">
                                    <numIndex index="0">default</numIndex>
                                    <numIndex index="1"></numIndex>
                                </numIndex>
                            </items>
                        </config>
                    </settings.field.eventLayout>
                    <settings.field.showItemsPerPage>
                        <exclude>1</exclude>
                        <label>Events pro Seite?</label>
                        <description>Wie viele Events sollen maximal pro Seite (pagination) angezeigt werden?</description>
                        <config>
                            <type>number</type>
                            <default>18</default>
                            <required>true</required>
                            <format>integer</format>
                            <range>
                                <lower>1</lower>
                                <upper>50</upper>
                            </range>
                        </config>
                    </settings.field.showItemsPerPage>

                    <settings.field.columnsCount>
                        <exclude>1</exclude>
                        <label>Maximale Spaltenanzahl?</label>
                        <description>Spalten richten sich nach dem Platz der ihnen zur Verfügung steht (Responsive).</description>
                        <config>
                            <type>number</type>
                            <default>3</default>
                            <required>true</required>
                            <format>integer</format>
                            <range>
                                <lower>2</lower>
                                <upper>4</upper>
                            </range>
                        </config>
                    </settings.field.columnsCount>

                    <settings.field.showPaginationBefore>
                        <exclude>1</exclude>
                        <label>Pagination before?</label>
                        <description></description>
                        <config>
                            <type>check</type>
                            <items>
                                <numIndex index="0" type="array">
                                    <numIndex index="0">anzeigen</numIndex>
                                    <numIndex index="1">1</numIndex>
                                </numIndex>
                            </items>
                        </config>
                    </settings.field.showPaginationBefore>

                    <settings.field.showPaginationAfter>
                        <exclude>1</exclude>
                        <label>Pagination after?</label>
                        <description></description>
                        <config>
                            <type>check</type>
                            <items>
                                <numIndex index="0" type="array">
                                    <numIndex index="0">anzeigen</numIndex>
                                    <numIndex index="1">1</numIndex>
                                </numIndex>
                            </items>
                        </config>
                    </settings.field.showPaginationAfter>
                </el>
            </ROOT>
        </layout>
    </sheets>
</T3DataStructure>
