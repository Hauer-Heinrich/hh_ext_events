{
    "type": "typo3-cms-extension",
    "name": "hauerheinrich/hh-ext-events",
    "description": "Hauer-Heinrich - Events",
    "keywords": ["TYPO3 CMS", "TYPO3", "extension", "events"],
    "homepage": "https://www.hauer-heinrich.de",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Christian Hackl",
            "homepage": "http://www.hauer-heinrich.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Hauer-Heinrich/hh_ext_events/issues",
        "source": "https://github.com/Hauer-Heinrich/hh_ext_events",
        "docs": "https://github.com/Hauer-Heinrich/hh_ext_events/blob/master/README.md"
    },
    "funding": [
        {
            "type": "paypal",
            "url": "https://www.paypal.com/paypalme/hauerheinrich"
        }
    ],
    "require": {
        "typo3/cms-core": "^13.4.0",
        "typo3/cms-fluid": "^13.4.0",
        "typo3/cms-frontend": "^13.4.0"
    },
    "autoload": {
        "psr-4": {
            "HauerHeinrich\\HhExtEvents\\": "Classes"
        }
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/Web",
            "extension-key": "hh_ext_events",
            "version": "1.2.0",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "archive": {
        "exclude": [
            "/.git/",
            "/.github/",
            "/.idea/",
            "/.editorconfig",
            "/.gitattributes",
            "/.gitignore",
            "/.bundle.config.json",
            "/.bundle.config.json.example",
            "/.bundle.mjs",
            "/package.json",
            "/package-lock.json",
            "/*.code-workspace",
            "**/node_modules/",
            "**/*.zip"
        ]
    }
}
